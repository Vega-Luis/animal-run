<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.Pane?>

<VBox
   alignment="CENTER"
   spacing="20.0"
   xmlns="http://javafx.com/javafx/8.0.171"
   xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.vegaluis.animalrun.PrimaryController"
>
   <children>
      <Label text="🐾 Animal Run 🐾" style="-fx-font-size: 28px; -fx-font-weight: bold;" />
      <Label text="Exploración de Java threads. Simulación de carreras de animales." style="-fx-font-size: 16px;"/>
      <Button fx:id="primaryButton" text="Continuar" onAction="#switchToSecondary"/>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
